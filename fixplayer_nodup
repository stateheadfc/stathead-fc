import json
import urllib.request
import boto3
from decimal import Decimal

# --- CONFIGURACIÓN ---
API_KEY = ""
LEAGUE_ID = 253
TABLE_NAME = "MLS_Players"
AWS_REGION = "us-east-2"

AWS_ACCESS_KEY = ""
AWS_SECRET_KEY = ""

# Configura aquí el ID de M. Farfan (FC Dallas) en 2022
TARGET_PLAYER_ID = "15647"  # Puedes verificar si este es su ID o buscarlo con el script anterior si cambia
TARGET_SEASON = "2022"

session = boto3.Session(
    aws_access_key_id=AWS_ACCESS_KEY,
    aws_secret_access_key=AWS_SECRET_KEY,
    region_name=AWS_REGION,
)
dynamodb = session.resource("dynamodb")


def safe_int(val):
  if val is None:
    return 0
  try:
    return int(val)
  except (ValueError, TypeError):
    return 0


def corregir_jugador_especifico():
  table = dynamodb.Table(TABLE_NAME)

  print(
      f"\n🔍 Consultando API para M. Farfan ID {TARGET_PLAYER_ID} (Temporada"
      f" {TARGET_SEASON})..."
  )

  url = f"https://v3.football.api-sports.io/players?id={TARGET_PLAYER_ID}&league={LEAGUE_ID}&season={TARGET_SEASON}"
  req = urllib.request.Request(url, headers={"x-apisports-key": API_KEY})

  try:
    with urllib.request.urlopen(req) as resp:
      data = json.loads(resp.read().decode("utf-8"))
      response_list = data.get("response", [])

      if not response_list:
        print(
            f"⚠️ No se encontró info en API para ID {TARGET_PLAYER_ID} (Temporada"
            f" {TARGET_SEASON})"
        )
        return

      entry = response_list[0]
      player_info = entry.get("player", {})
      statistics = entry.get("statistics", [])

      stats_mls = [
          st for st in statistics if st.get("league", {}).get("id") == LEAGUE_ID
      ]

      if not stats_mls:
        print(
            f"⚠️ El jugador {TARGET_PLAYER_ID} no tiene registros de la MLS en"
            f" {TARGET_SEASON}."
        )
        return

      # --- DEDUPLICACIÓN PARA EVITAR MÉTRICAS DUPLICADAS (X2) ---
      seen_teams = {}
      unique_stats_mls = []
      for st in stats_mls:
        team_id = st.get("team", {}).get("id")
        minutes = safe_int((st.get("games", {}) or {}).get("minutes"))
        if team_id in seen_teams:
          if minutes > seen_teams[team_id]:
            seen_teams[team_id] = minutes
            unique_stats_mls = [
                x
                for x in unique_stats_mls
                if x.get("team", {}).get("id") != team_id
            ]
            unique_stats_mls.append(st)
        else:
          seen_teams[team_id] = minutes
          unique_stats_mls.append(st)

      stats_mls = unique_stats_mls

      stats_mls.sort(
          key=lambda x: safe_int((x.get("games", {}) or {}).get("minutes")),
          reverse=True,
      )
      main_stat = stats_mls[0]
      main_team_info = main_stat.get("team", {})

      tot_appearances = 0
      tot_lineups = 0
      tot_minutes = 0
      tot_goals = 0
      tot_conceded = 0
      tot_assists = 0
      tot_saves = 0
      tot_passes_total = 0
      tot_passes_key = 0
      tot_tackles = 0
      tot_blocks = 0
      tot_interceptions = 0
      tot_duels_total = 0
      tot_duels_won = 0
      tot_dribbles_att = 0
      tot_dribbles_succ = 0
      tot_dribbles_past = 0
      tot_fouls_comm = 0
      tot_fouls_drawn = 0
      tot_yellow = 0
      tot_yellow_red = 0
      tot_red = 0
      tot_pen_comm = 0
      tot_pen_miss = 0
      tot_pen_saved = 0
      tot_pen_scored = 0
      tot_pen_won = 0
      tot_shots_total = 0
      tot_shots_on = 0
      tot_sub_bench = 0
      tot_sub_in = 0
      tot_sub_out = 0

      sum_ratings = Decimal("0.0")
      rating_count = 0
      sum_passes_acc = 0
      acc_count = 0

      is_captain = False
      is_injured = False

      for sb in stats_mls:
        g = sb.get("games", {}) or {}
        go = sb.get("goals", {}) or {}
        pa = sb.get("passes", {}) or {}
        ta = sb.get("tackles", {}) or {}
        du = sb.get("duels", {}) or {}
        dr = sb.get("dribbles", {}) or {}
        fo = sb.get("fouls", {}) or {}
        ca = sb.get("cards", {}) or {}
        pe = sb.get("penalty", {}) or {}
        sh = sb.get("shots", {}) or {}
        su = sb.get("substitutes", {}) or {}

        apps = (
            g.get("appearences")
            if g.get("appearences") is not None
            else g.get("appearances")
        )
        tot_appearances += safe_int(apps)
        tot_lineups += safe_int(g.get("lineups"))
        tot_minutes += safe_int(g.get("minutes"))

        if g.get("captain"):
          is_captain = True
        if g.get("injured"):
          is_injured = True

        r = g.get("rating")
        if r:
          try:
            sum_ratings += Decimal(str(r))
            rating_count += 1
          except Exception:
            pass

        tot_goals += safe_int(go.get("total"))
        tot_conceded += safe_int(go.get("conceded"))
        tot_assists += safe_int(go.get("assists"))
        tot_saves += safe_int(go.get("saves"))

        tot_passes_total += safe_int(pa.get("total"))
        tot_passes_key += safe_int(pa.get("key"))
        ac = pa.get("accuracy")
        if ac is not None and ac != "":
          try:
            sum_passes_acc += int(ac)
            acc_count += 1
          except Exception:
            pass

        tot_tackles += safe_int(ta.get("total"))
        tot_blocks += safe_int(ta.get("blocks"))
        tot_interceptions += safe_int(ta.get("interceptions"))

        tot_duels_total += safe_int(du.get("total"))
        tot_duels_won += safe_int(du.get("won"))

        tot_dribbles_att += safe_int(dr.get("attempts"))
        tot_dribbles_succ += safe_int(dr.get("success"))
        tot_dribbles_past += safe_int(dr.get("past"))

        tot_fouls_comm += safe_int(fo.get("committed"))
        tot_fouls_drawn += safe_int(fo.get("drawn"))

        tot_yellow += safe_int(ca.get("yellow"))
        tot_yellow_red += safe_int(ca.get("yellowred"))
        tot_red += safe_int(ca.get("red"))

        tot_pen_comm += safe_int(pe.get("committed"))
        tot_pen_miss += safe_int(pe.get("missed"))
        tot_pen_saved += safe_int(pe.get("saved"))
        tot_pen_scored += safe_int(pe.get("scored"))
        tot_pen_won += safe_int(pe.get("won"))

        tot_shots_total += safe_int(sh.get("total"))
        tot_shots_on += safe_int(sh.get("on"))

        tot_sub_bench += safe_int(su.get("bench"))
        tot_sub_in += safe_int(su.get("in"))
        tot_sub_out += safe_int(su.get("out"))

      final_rating = (
          round(sum_ratings / rating_count, 4)
          if rating_count > 0
          else Decimal("0.0")
      )
      final_accuracy = (
          Decimal(str(round(sum_passes_acc / acc_count, 2)))
          if acc_count > 0
          else Decimal("0.0")
      )

      main_games = main_stat.get("games", {}) or {}
      team_name = main_team_info.get("name", "Desconocido")
      p_name = player_info.get("name", "Desconocido")

      item_to_save = {
          "player_id": str(TARGET_PLAYER_ID),
          "season": str(TARGET_SEASON),
          "age": safe_int(player_info.get("age")),
          "appearances": tot_appearances,
          "assists": tot_assists,
          "birth_country": player_info.get("birth", {}).get("country", "")
          or "",
          "birth_date": player_info.get("birth", {}).get("date", "") or "",
          "birth_place": player_info.get("birth", {}).get("place", "") or "",
          "blocks": tot_blocks,
          "captain": is_captain,
          "dribbles_attempts": tot_dribbles_att,
          "dribbles_past": tot_dribbles_past,
          "dribbles_success": tot_dribbles_succ,
          "duels_total": tot_duels_total,
          "duels_won": tot_duels_won,
          "firstname": player_info.get("firstname", "") or "",
          "fouls_committed": tot_fouls_comm,
          "fouls_drawn": tot_fouls_drawn,
          "goals": tot_goals,
          "goals_conceded": tot_conceded,
          "height": player_info.get("height", "") or "",
          "injured": player_info.get("injured", False) or False,
          "interceptions": tot_interceptions,
          "lastname": player_info.get("lastname", "") or "",
          "lineups": tot_lineups,
          "minutes": tot_minutes,
          "nationality": player_info.get("nationality", "") or "",
          "number": safe_int(main_games.get("number")),
          "passes_accuracy": final_accuracy,
          "passes_key": tot_passes_key,
          "passes_total": tot_passes_total,
          "penalty_committed": tot_pen_comm,
          "penalty_missed": tot_pen_miss,
          "penalty_saved": tot_pen_saved,
          "penalty_scored": tot_pen_scored,
          "penalty_won": tot_pen_won,
          "photo": player_info.get("photo", ""),
          "player_name": p_name,
          "position": main_games.get("position", ""),
          "rating": final_rating,
          "red_cards": tot_red,
          "saves": tot_saves,
          "shots_on": tot_shots_on,
          "shots_total": tot_shots_total,
          "sub_bench": tot_sub_bench,
          "sub_in": tot_sub_in,
          "sub_out": tot_sub_out,
          "tackles_total": tot_tackles,
          "team_logo": main_team_info.get("logo", ""),
          "team_name": team_name,
          "weight": player_info.get("weight", ""),
          "yellow_cards": tot_yellow,
          "yellow_red_cards": tot_yellow_red,
      }

      table.put_item(Item=item_to_save)
      print(
          f"✅ ¡M. Farfan corregido con éxito (sin duplicar)!\n"
          f" - Nombre: {p_name}\n"
          f" - Equipo: {team_name}\n"
          f" - Apps: {tot_appearances} | Minutos: {tot_minutes} | Pases Totales:"
          f" {tot_passes_total}"
      )

  except Exception as e:
    print(f"❌ Error procesando ID {TARGET_PLAYER_ID}: {e}")


if __name__ == "__main__":
  corregir_jugador_especifico()